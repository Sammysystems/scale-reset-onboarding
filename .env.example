# Model provider: mock | openai-compatible
MODEL_PROVIDER=mock

# OpenAI-compatible endpoint.
# InsForge Model Gateway is OpenRouter behind the scenes. Run
#   npx -y @insforge/cli ai setup --env-file .env
# from the folder that holds .insforge/project.json, then verify the model id with
#   GET https://openrouter.ai/api/v1/models
# and wire it like this:
#   MODEL_PROVIDER=openai-compatible
#   MODEL_BASE_URL=https://openrouter.ai/api/v1
#   MODEL_API_KEY=$OPENROUTER_API_KEY
#   MODEL_NAME=<a verified openrouter model id>
# Local fallback: MODEL_BASE_URL=http://127.0.0.1:20128/v1
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Workflow
STUDIO_PROJECT=client-onboarding
COMPLETENESS_THRESHOLD=70
MAX_DRAFT_ATTEMPTS=2
AUTO_APPROVE=false

# Deliverables + local persistence
DELIVERABLES_ROOT=deliverables
DATA_ROOT=.data

# Operator notifications (Telegram preferred)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFIER=console

# HTTP runner
PORT=8790
HOST=127.0.0.1
RUNNER_TOKEN=

# Client profile persistence (Postgres behind the workflow kit). Leave blank for demo profile.
DATABASE_URL=
DB_SCHEMA=public
TABLE_PREFIX=onboarding_

# Studio (interactive two-phase onboarding: discovery -> proposal -> onboarding)
STUDIO_PORT=8790
# Protects /admin and /api/admin/*. Leave blank on localhost for a frictionless demo.
ADMIN_TOKEN=
# Booking. Every booking opens a custom modal, then continues to WhatsApp.
WHATSAPP_NUMBER=2348035248296
# Proposal links. Blank CALL_URL falls back to https://wa.me/<WHATSAPP_NUMBER>.
CALL_URL=
PAYMENT_URL=
WHATSAPP_URL=
# InsForge persistence. Leave both blank to use local discovery files.
INSFORGE_URL=
INSFORGE_API_KEY=
INSFORGE_DISCOVERY_TABLE=scale_reset_discoveries
# Who gets the "call booked" notification. Blank keeps it out of the outbox.
OPERATOR_EMAIL=
# Where discovery sessions and email drafts are written.
DISCOVERY_ROOT=.data/discovery
OUTBOX_DIR=.data/outbox
# Email delivery. Without these, proposals are written to the outbox only.
RESEND_API_KEY=
RESEND_FROM=
