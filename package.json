{
  "name": "@studio/client-onboarding-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client onboarding research engine: intake -> screen -> research -> draft -> approval -> finalize, on the Studio workflow kit.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "demo": "node --import tsx src/demo.ts",
    "preview": "node --import tsx src/preview.ts",
    "serve": "node --import tsx src/run-server.ts",
    "studio": "node --import tsx src/studio.ts",
    "studio:demo": "node --import tsx src/studio.ts --demo"
  },
  "dependencies": {
    "@insforge/sdk": "1.5.2",
    "@voltagent/core": "2.8.0",
    "pg": "^8.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}
